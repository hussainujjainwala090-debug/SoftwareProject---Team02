# Copy to .env (never commit .env). All names start with AGRISCAN_.

# memory = runs with no Firebase project (in-memory data, local files, dev tokens)
# firebase = Firestore, Cloud Storage, Cloud Messaging, Firebase ID tokens
AGRISCAN_MODE=memory

# firebase mode only: path to the service-account key file, kept OUTSIDE the repo
AGRISCAN_FIREBASE_CREDENTIALS=
AGRISCAN_FIREBASE_STORAGE_BUCKET=

# Address the app uses to reach this server (memory-mode file links)
AGRISCAN_PUBLIC_BASE_URL=http://localhost:8000

# Emails that become admin when they register (JSON list)
AGRISCAN_ADMIN_EMAILS=[]

# Scan rules
AGRISCAN_CONFIDENCE_THRESHOLD=0.70
AGRISCAN_SEVERITY_MEDIUM_FROM_PCT=15
AGRISCAN_SEVERITY_HIGH_FROM_PCT=40
AGRISCAN_BLUR_THRESHOLD=60

# Weather: open-meteo (no key needed) or fake (offline demo)
AGRISCAN_WEATHER_PROVIDER=open-meteo
AGRISCAN_WEATHER_CACHE_MAX_HOURS=6

# Minutes between automatic climate-alert checks (0 = off)
AGRISCAN_ALERT_INTERVAL_MINUTES=0

# Trained classifier (produced by the ML training step in src/ml; optional)
AGRISCAN_CLASSIFIER_MODEL_PATH=../ml/models/classifier.keras
AGRISCAN_CLASSIFIER_LABELS_PATH=../ml/models/labels.json
