rules_version = '2';

// The Flutter app never reads or writes Firestore directly: every request goes
// through the FastAPI backend, which uses the Admin SDK (not bound by these
// rules), verifies the Firebase ID token, checks the role and enforces the
// keys and constraints of the data design (UNIQUE, NOT NULL, ranges).
// Denying direct access means a user cannot bypass those checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
